# Anthropic API Key (Optional)
# If left blank, the agent automatically executes the built-in deterministic autonomous graph policy
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5

# FalkorDB Connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# Lab Configuration Path
# LAB_CONFIG_DIR=./lab/config
